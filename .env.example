APP_ENV=development
SECRET_KEY=replace-with-a-local-secret
DEMO_USERNAME=engineer01
DEMO_PASSWORD=change-me-before-demo
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Server-only Agent credentials; never use NEXT_PUBLIC_* for these values.
AGENT_INVOKE_URL=http://192.168.64.3:8300/api/v1/agent/invoke/stream
# Optional: structured UC/FR generation endpoint. Empty means derive /invoke from the stream URL.
AGENT_GENERATION_INVOKE_URL=
AGENT_API_KEY=replace-with-agent-key
# Separate key for Agent -> backend read-only template callbacks.
AGENT_CALLBACK_KEY=replace-with-agent-callback-key
AGENT_TIMEOUT_SECONDS=300

# Optional project READ API. Leave empty until its least-privilege role/tunnel are configured.
PROJECTS_DATABASE_URL=
PROJECTS_CONNECT_TIMEOUT_SECONDS=3


# Project creation is opt-in. Reader DSN: ee_project_api_ro; writer DSN: ee_project_api_rw.
# Switch the username only after the reviewed migration. Never put credentials in NEXT_PUBLIC variables.
PROJECTS_WRITE_DATABASE_URL=
PROJECTS_CREATE_SUBJECTS=
PROJECTS_WRITE_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Shared ee_project_api_rw writer (renamed from ee_project_api_create); no new login per feature.
# Enable only AFTER the reviewed manual-work SQL package and project role bindings.
BUSINESS_WRITES_ENABLED=false

# Optional global account-admin subjects (comma-separated external_subject values). Leave empty to disable account management.
ACCOUNT_ADMIN_SUBJECTS=

# Independent Agent console observations (OFF by default; no business DB writes).
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_KEY=
DIAGNOSTICS_PROJECT_IDS=



